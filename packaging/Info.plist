<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist template for the MeetingGenie .app bundle (plan U1/U2).
  scripts/package-app.sh substitutes __SHORT_VERSION__ and __BUILD_VERSION__.
  SUFeedURL / SUPublicEDKey are filled in once Sparkle (U2) and the EdDSA
  keypair (U9) exist — left as comments here so the unsigned/dev bundle builds.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MeetingGenie</string>
    <key>CFBundleDisplayName</key>
    <string>MeetingGenie</string>
    <key>CFBundleIdentifier</key>
    <string>com.fontesgerards.meetinggenie</string>
    <key>CFBundleExecutable</key>
    <string>MeetingGenie</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__SHORT_VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD_VERSION__</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Sparkle auto-update (U2). The feed is https and is the app's only
         network call. SUPublicEDKey is the public half of the EdDSA keypair
         whose private key lives in the maintainer's login Keychain. -->
    <key>SUFeedURL</key>
    <string>https://fontesgerards.github.io/meetinggenie/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>ZkySM601fAVqLhBah0nECljerD65RA67n0o+40QhhXM=</string>
    <key>SUEnableInstallerLauncherService</key>
    <false/>
</dict>
</plist>
